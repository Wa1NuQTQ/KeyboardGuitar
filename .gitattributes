# Text files use UTF-8 and LF; Unreal assets are never merged as text.
* text=auto eol=lf

*.uasset binary
*.umap binary
*.ubulk binary
*.uexp binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.gif binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary

*.bat text eol=crlf
*.cmd text eol=crlf
